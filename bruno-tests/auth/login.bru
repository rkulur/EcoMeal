meta {
  name: Login
  type: http
  seq: 1
}

post {
  url: http://localhost:3000/api/v1/auth/login
  body: json
  auth: inherit
}

headers {
  Content-Type: application/json
}

body:json {
  {
    "email": "donor@gmail.com",
    "password": "securepassword"
  }
}

script:post-response {
  const role = res.body.payload.role
  bru.setEnvVar(`${role}Token`,res.body.payload.token)
}
