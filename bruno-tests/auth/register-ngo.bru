meta {
  name: Register NGO
  type: http
  seq: 5
}

post {
  url: http://localhost:3000/api/v1/auth/register/ngo
  body: json
  auth: inherit
}

headers {
  Content-Type: application/json
}

body {
  {
    "name": "Helping Hands",
    "email": "ngo@example.com",
    "phone": "9876543212",
    "password": "securepass",
    "confirmPassword": "securepass",
    "location": {
      "state": "Karnataka",
      "district": "Dakshina Kannada",
      "city": "Mangalore",
      "pincode": "575001"
    },
    "preferredPickupTime": "9:00 AM",
    "foodTypesAccepted": ["vegetarian", "vegan"],
    "servingCapacity": 100,
    "nextPickupTime": "1:00 PM",
    "profilePicture": "url-to-profile.jpg",
    "verificationDocument": "url-to-doc.pdf",
    "socialMedia": {
      "website": "https://example.org",
      "facebook": "ecoMealFB",
      "instagram": "ecoMealInsta",
      "twitter": "ecoMealTwitter"
    }
  }
}

script:post-response {
  bru.setVar(ngoToken,res.body.token)
}
