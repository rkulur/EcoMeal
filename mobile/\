        <PoppinsText style={{ flex: 1 }}>
          {(donation.distance / 1000).toFixed(2)} Km
        </PoppinsText>
      </View>
      <View style={{ flexDirection: "row", gap: 5 }}>
        <Ionicons name="time-outline" size={20} color={COLORS.purple} />
