          <View style={{ alignItems: "center" }}>
            <PoppinsText
              style={{
                fontFamily: FONT.SEMI_BOLD,
                fontSize: FONT_SIZE.xmedium,
              }}
            >
              {getDonationName(donation)}
            </PoppinsText>
            <View style={{ flexDirection: "row", gap: 10 }}>
              <PoppinsText>
                {donation.foodItems.reduce(
                  (acc, item) => acc + item.quantity,
